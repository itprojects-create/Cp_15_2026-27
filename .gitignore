# ==============================================================================
# Git Ignore Configuration for VESIT Capstone Project (Sem 6 & Sem 7)
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/
vendor/
**/vendor/

# Environment and Credentials (CRITICAL: Do NOT commit .env with real passwords)
.env
**/.env
.env.backup
.env.production
.env.*.local
!.env.example
!**/.env.example

# Laravel Framework Caches & Storage
**/storage/*.key
**/storage/pail
**/storage/framework/cache/data/*
**/storage/framework/sessions/*
**/storage/framework/views/*
**/storage/logs/*.log
**/storage/debugbar/
**/bootstrap/cache/*.php
!**/bootstrap/cache/.gitignore

# Build outputs & dev locks
**/public/hot
**/public/storage
**/public/build
**/.phpunit.result.cache
**/.phpunit.cache
**/scratch/

# Large video files (>100MB exceeds GitHub push limit)
*.mp4
**/*.mp4

# IDE & OS Junk
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
